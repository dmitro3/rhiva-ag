{
  "name": "@rhiva-ag/decoder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./dist/index.cjs",
      "import": "./src/index.ts"
    },
    "./programs/*": {
      "types": "./src/programs/*.ts",
      "require": "./dist/programs/*.cjs",
      "import": "./src/programs/*.ts"
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsup src/index.ts src/programs/**/*.ts --minify --treeshake"
  },
  "peerDependencies": {
    "@rhiva-ag/shared": "*",
    "@coral-xyz/anchor": "0.32.1",
    "typescript": "^5.9.2",
    "@solana/spl-token": "^0.4.14"
  },
  "devDependencies": {
    "@tsconfig/bun": "^1.0.9"
  }
}
