{
  "name": "@rhiva-ag/dex",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "browser": "./src/index.browser.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./src/index.browser.ts",
      "default": "./src/index.browser.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "require": "./dist/utils/index.cjs",
      "import": "./src/utils/index.ts"
    }
  },
  "scripts": {
    "codegen": "bun x @rhiva-ag/env --out tests/env.ts",
    "build": "tsup src/index.ts ./src/utils/index.ts --minify --treeshake"
  },
  "peerDependencies": {
    "@meteora-ag/dlmm": "../../bin/meteora-ag-dlmm-0.0.0.tgz",
    "@saros-finance/dlmm-sdk": "../../bin/saros-finance-dlmm-sdk-0.0.0.tgz",
    "@orca-so/whirlpools-sdk": "../../bin/orca-so-whirlpools-0.0.0.tgz",
    "@raydium-io/raydium-sdk-v2": "../../bin/raydium-io-raydium-sdk-v2-0.0.0.tgz",
    "bn.js": "^5.2.2",
    "decimal.js": "^10.6.0",
    "@coral-xyz/anchor": "^0.32.1",
    "@solana-program/token": "^0.7.0",
    "@solana/compat": "^5.0.0",
    "@solana/kit": "^5.0.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4"
  },
  "dependencies": {
    "@jup-ag/api": "^6.0.46",
    "@rhiva-ag/shared": "*",
    "@rhiva-ag/decoder": "*"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/bun": "^1.3.2",
    "@tsconfig/bun": "^1.0.9"
  }
}
