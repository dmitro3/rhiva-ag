{
  "name": "@rhiva-ag/shared",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "module": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./dist/index.cjs",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsup src/index.ts --minify --treeshake",
    "codegen": "bun x @rhiva-ag/env --out tests/env.ts"
  },
  "peerDependencies": {
    "xior": "^0.7.8",
    "@solana-program/system": "^0.10.0",
    "@solana/compat": "^5.0.0",
    "@solana/kit": "^5.0.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0"
  },
  "dependencies": {
    "@rhiva-ag/decoder": "*",
    "@aws-sdk/client-kms": "^3.914.0",
    "lodash.chunk": "^4.2.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@tsconfig/bun": "^1.0.9",
    "@types/bun": "^1.3.0",
    "@types/lodash.chunk": "^4.2.9"
  }
}
