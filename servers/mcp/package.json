{
  "name": "@rhiva-ag/mcp",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "types": "./src/external.ts",
  "main": "./src/external.ts",
  "module": "./src/external.ts",
  "exports": {
    ".": {
      "types": "./src/external.ts",
      "require": "./src/external.ts",
      "import": "./src/external.ts"
    },
    "./client": {
      "type": "./src/client.ts",
      "require": "./dist/client.cjs",
      "import": "./src/client.ts"
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "codegen": "bun x @rhiva-ag/env",
    "dev": "bun run --watch src/index.ts",
    "build": "tsup src/index.ts src/external.ts src/client.ts --treeshake --minify"
  },
  "dependencies": {
    "@coingecko/coingecko-typescript": "^2.2.0",
    "@modelcontextprotocol/sdk": "npm:@socotra/modelcontextprotocol-sdk",
    "@openai/agents": "^0.1.11",
    "@rhiva-ag/datasource": "*",
    "@rhiva-ag/dex-api": "*",
    "@rhiva-ag/shared": "*",
    "fastify": "^5.6.1",
    "fastify-mcp": "^2.0.8",
    "fs": "^0.0.1-security",
    "path": "^0.12.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tsconfig/bun": "^1.0.9"
  }
}
